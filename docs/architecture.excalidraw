   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Supervisor: validate \u2192 state table \u2192 slot decision (keep \u00b7 adopt \u00b7 create \u00b7 recreate once \u00b7 refuse) \u2192 START_REPLICATION, messages on\nretry: backoff + jitter  \u00b7  fatal, no retry: slot lost or unusable, state store unusable, sink rejected, sink stuck\nSIGTERM: stop admission, drain with deadline, ack, close",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Supervisor: validate \u2192 state table \u2192 slot decision (keep \u00b7 adopt \u00b7 create \u00b7 recreate once \u00b7 refuse) \u2192 START_REPLICATION, messages on\nretry: backoff + jitter  \u00b7  fatal, no retry: slot lost or unusable, state store unusable, sink rejected, sink stuck\nSIGTERM: stop admission, drain with deadline, ack, close",
   "autoResize": false,
   "lineHeight": 1.25
  },
