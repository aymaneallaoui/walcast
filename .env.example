# trace | debug | info | warn | error
LOG_LEVEL=debug
# json | console
LOG_FORMAT=console
SHUTDOWN_TIMEOUT=10s
# SINK_SETTLE_TIMEOUT=5m

DATABASE_URL=postgres://walcast:walcast@localhost:5432/walcast?sslmode=disable

SLOT_NAME=walcast_slot
PUBLICATION_NAME=walcast_pub
# comma separated schema.table list, empty = all tables (needs superuser)
PUBLICATION_TABLES=

# stdout | webhook | kafka
SINK=stdout
# https only, plain http is accepted for localhost
# WEBHOOK_URL=https://hooks.example.com/walcast
# at least 16 characters, used to sign every request
# WEBHOOK_SECRET=
# WEBHOOK_TIMEOUT=10s
# WEBHOOK_RETRY_MIN=500ms
# WEBHOOK_RETRY_MAX=30s

# comma separated host:port list
# KAFKA_BROKERS=localhost:9092
# topic is prefix + schema.table
# KAFKA_TOPIC_PREFIX=walcast.
# KAFKA_CLIENT_ID=walcast
# required unless every broker is a loopback host
# KAFKA_TLS=true
# plain | scram-sha-256 | scram-sha-512
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_MAX_MESSAGE_BYTES=1000012
# KAFKA_EMIT_TRUNCATE=false

# tuning, defaults shown
# FEEDBACK_INTERVAL=5s
# SERVER_TIMEOUT=60s
# BATCH_MAX_BYTES=65536
# BATCH_LINGER=5ms
# INFLIGHT_MAX_BYTES=67108864
# RECONNECT_MIN_DELAY=500ms
# RECONNECT_MAX_DELAY=30s

# docker compose only
POSTGRES_USER=walcast
POSTGRES_PASSWORD=walcast
POSTGRES_DB=walcast
POSTGRES_PORT=5432
